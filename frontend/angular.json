{
  "version": 1,
  "projects": {
    "novastore-auth": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": [
              "src/styles.css"
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "novastore-auth:build",
            "proxyConfig": "src/proxy.conf.json"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "e19f991d-b579-4cb9-9ed5-3303c0129f8f"
  }
}
