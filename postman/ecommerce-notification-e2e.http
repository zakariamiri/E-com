# End-to-end: create user -> create category -> product -> order -> inspect notification
# Run the requests from top to bottom in IntelliJ IDEA. The response handlers
# save each returned ID for the following request.

@productBaseUrl = http://localhost:8086
@orderBaseUrl = http://localhost:8084
@notificationBaseUrl = http://localhost:8083
@authBaseUrl = http://localhost:8081
@cartBaseUrl = http://localhost:8082
@quantity = 1

### 1. Create a customer in Auth-service
# @name createUser
POST {{authBaseUrl}}/api/users
Content-Type: application/json

{
  "firstName": "E2E",
  "lastName": "Customer",
  "email": "e2e-{{$uuid}}@example.com",
  "password": "Passw0rd!"
}

> {%
  client.test("User created", function () {
    client.assert(response.status === 201, "Expected HTTP 201, got " + response.status);
    client.assert(response.body.id !== undefined, "User response must contain id");
  });
  client.global.set("e2eCustomerId", response.body.id);
%}

### 2. Create a product category
# @name createCategory
POST {{productBaseUrl}}/api/categories
Content-Type: application/json

{
  "name": "E2E category {{$uuid}}",
  "description": "Created by the product-to-notification smoke test",
  "parentId": null
}

> {%
  client.test("Category created", function () {
    client.assert(response.status === 201, "Expected HTTP 201, got " + response.status);
    client.assert(response.body.id !== undefined, "Category response must contain id");
  });
  client.global.set("e2eCategoryId", response.body.id);
%}

### 3. Create a published product in that category
# @name createProduct
POST {{productBaseUrl}}/api/products
Content-Type: application/json

{
  "name": "E2E notification product",
  "description": "Created by the product-to-notification smoke test",
  "brand": "E2E",
  "sku": "E2E-{{$uuid}}",
  "price": 19.99,
  "stockQuantity": 5,
  "status": "PUBLISHED",
  "categoryId": {{e2eCategoryId}}
}

> {%
  client.test("Product created", function () {
    client.assert(response.status === 201, "Expected HTTP 201, got " + response.status);
    client.assert(response.body.id !== undefined, "Product response must contain id");
    client.assert(response.body.available === true, "Product should be available");
  });
  client.global.set("e2eProductId", response.body.id);
%}

### 4. Create a cart for that user
# @name createCart
POST {{cartBaseUrl}}/api/carts
Content-Type: application/json

{
  "userId": {{e2eCustomerId}}
}

> {%
  client.test("Cart created", function () {
    client.assert(response.status === 201, "Expected HTTP 201, got " + response.status);
    client.assert(response.body.id !== undefined, "Cart response must contain id");
  });
  client.global.set("e2eCartId", response.body.id);
%}

### 5. Add product to the cart
# @name addCartItem
POST {{cartBaseUrl}}/api/carts/{{e2eCartId}}/items
Content-Type: application/json

{
  "productId": {{e2eProductId}},
  "quantity": {{quantity}}
}

> {%
  client.test("Cart item added", function () {
    client.assert(response.status === 200, "Expected HTTP 200, got " + response.status);
    client.assert(response.body.items.length === 1, "Expected one item in cart");
  });
%}

### 6. Create an order from cart (publishes order.created after database commit)
# @name createOrderFromCart
POST {{orderBaseUrl}}/api/orders/from-cart/{{e2eCustomerId}}
Idempotency-Key: {{$uuid}}
Content-Type: application/json

{
  "shippingAddress": "12 rue de Démonstration, Casablanca"
}

> {%
  client.test("Order created", function () {
    client.assert(response.status === 201, "Expected HTTP 201, got " + response.status);
    client.assert(response.body.id !== undefined, "Order response must contain id");
    client.assert(response.body.status === "CREATED", "Expected CREATED order status");
  });
  client.global.set("e2eOrderId", response.body.id);
%}

### 7. Confirm the saved order and its product snapshot
GET {{orderBaseUrl}}/api/orders/{{e2eOrderId}}
Accept: application/json

> {%
  client.test("Order contains the created product", function () {
    client.assert(response.status === 200, "Expected HTTP 200, got " + response.status);
    client.assert(response.body.items.length === 1, "Expected one order item");
    client.assert(String(response.body.items[0].productId) === String(client.global.get("e2eProductId")),
      "Order item should reference the product created above");
  });
%}

### 8. Verify cart was cleared after checkout
GET {{cartBaseUrl}}/api/carts/{{e2eCartId}}
Accept: application/json

> {%
  client.test("Cart is empty after order checkout", function () {
    client.assert(response.status === 200, "Expected HTTP 200, got " + response.status);
    client.assert(response.body.items.length === 0, "Expected cart to be cleared");
  });
%}

### 9. Confirm Notification-service is healthy
GET {{notificationBaseUrl}}/actuator/health
Accept: application/json

> {%
  client.test("Notification-service is up", function () {
    client.assert(response.status === 200, "Expected HTTP 200, got " + response.status);
    client.assert(response.body.status === "UP", "Notification-service health should be UP");
  });
%}
